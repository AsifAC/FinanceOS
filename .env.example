# Supabase Project Settings -> API
VITE_SUPABASE_URL=

# Public anon/publishable key from Supabase Project Settings -> API.
# This key is safe for frontend use when paired with correct RLS policies.
VITE_SUPABASE_ANON_KEY=

# Never put service_role keys in frontend code or Vite env files.
